rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 4. Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.age is int && data.age >= 18 &&
             data.gender in ['male', 'female', 'other'] &&
             data.role in ['user', 'admin', 'moderator'];
    }

    // --- Admin Collection (Trusted source for roles) ---
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Cloud Console initially
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(incoming()) &&
        incoming().role == existing().role && // Prevent self-elevation
        incoming().isVerified == existing().isVerified && // Prevent self-verification
        incoming().isBanned == existing().isBanned // Prevent self-unbanning
      );
      allow delete: if isAdmin();
    }

    // --- Reports ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Matches & Messages ---
    match /matches/{matchId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().users || isAdmin());
      allow create: if isSignedIn(); // Simplified for now, logic usually involves dual-opt-in
      allow update, delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users || isAdmin());
        allow create: if isSignedIn() && 
                      request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
                      incoming().senderId == request.auth.uid &&
                      incoming().text.size() < 1000;
        allow update, delete: if isAdmin();
      }
    }
  }
}
