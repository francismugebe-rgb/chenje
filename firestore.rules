rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isPremium(uid) { 
      let data = getUserData(uid);
      return data.premiumTier in ['gold', 'platinum', 'vip'];
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 4. Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 100 &&
             data.firstName is string && data.firstName.size() <= 50 &&
             data.lastName is string && data.lastName.size() <= 50 &&
             data.age is int && data.age >= 18 &&
             data.gender in ['male', 'female', 'other'] &&
             data.premiumTier in ['free', 'gold', 'platinum', 'vip'] &&
             data.role in ['user', 'admin', 'moderator'];
    }

    // --- Admin Collection ---
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'user' && incoming().premiumTier == 'free';
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(incoming()) &&
        incoming().role == existing().role &&
        incoming().isVerified == existing().isVerified &&
        incoming().premiumTier == existing().premiumTier && 
        incoming().isBanned == existing().isBanned
      );
      allow delete: if isAdmin();
    }

    // --- Likes ---
    match /likes/{likeId} {
      allow read: if isSignedIn() && (incoming().from == request.auth.uid || incoming().to == request.auth.uid);
      allow create: if isSignedIn() && incoming().from == request.auth.uid;
      allow delete: if isSignedIn() && existing().from == request.auth.uid;
    }

    // --- WhatsApp Numbers (Premium Only Access) ---
    match /whatsappNumbers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isPremium(request.auth.uid));
      allow create, update: if isOwner(userId) && incoming().number is string && incoming().number.size() < 20;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // --- Reports ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Matches & Messages ---
    match /matches/{matchId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().users || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in incoming().users;
      allow update: if isSignedIn() && (request.auth.uid in existing().users || isAdmin());
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users || isAdmin());
        allow create: if isSignedIn() && 
                      request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users &&
                      incoming().senderId == request.auth.uid &&
                      incoming().text.size() < 1000 &&
                      (
                        isPremium(request.auth.uid) || 
                        get(/databases/$(database)/documents/matches/$(matchId)).data.messageCount[request.auth.uid] < 2
                      );
        allow update, delete: if isAdmin();
      }
    }
  }
}
