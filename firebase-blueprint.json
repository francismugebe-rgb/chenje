{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Base user data for HomeHelp Connect.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["worker", "employer", "admin"] },
        "surname": { "type": "string" },
        "firstName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "location": { "type": "string" },
        "photoURL": { "type": "string" },
        "employerStatus": { "type": "string", "enum": ["Mr", "Mrs", "Miss", "Family", "Company"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "firstName", "surname"]
    },
    "WorkerProfile": {
      "title": "Worker Profile",
      "description": "Detailed professional data for domestic workers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "yearsExperience": { "type": "integer" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "salaryExpectation": { "type": "string" },
        "availability": { "type": "string", "enum": ["Available", "Busy", "Away"] },
        "bio": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "hasPoliceClearance": { "type": "boolean" },
        "policeClearanceUrl": { "type": "string" },
        "workPhotos": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" }
      },
      "required": ["userId", "category", "yearsExperience", "availability"]
    },
    "Review": {
      "title": "Review",
      "description": "Ratings and feedback for workers.",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toWorkerId": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromId", "toWorkerId", "rating"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core account data for all users."
    },
    "/worker_profiles/{userId}": {
      "schema": "WorkerProfile",
      "description": "Professional profiles for registered workers."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Worker ratings and reviews."
    },
    "/verifications/{verifyId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "policeClearanceUrl": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
          "submittedAt": { "type": "string", "format": "date-time" },
          "reviewedBy": { "type": "string" }
        }
      },
      "description": "Admin queue for police clearance verification."
    },
    "/settings/{configId}": {
      "schema": {
        "type": "object",
        "properties": {
          "siteName": { "type": "string" },
          "siteLogo": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Global application configuration."
    }
  }
}
